
# Postgres connection string. If you use the included docker-compose.yml, this default works as-is
# (it maps the container's 5432 to 5433 on the host, to avoid clashing with a Postgres you already have locally).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/toph"

# Secret used to sign session JWTs (see src/lib/session.ts) — generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"
